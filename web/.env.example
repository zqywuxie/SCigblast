# Linux host paths. These values are used by docker-compose.yml.
# Web, four pipelines and the default Barcode CSV are included in the image.
SCIGBLAST_HOST_COLD_DATA=/colddata
SCIGBLAST_HOST_RESULTS_ROOT=/colddata/SCigblast/results
SCIGBLAST_WEB_PORT=8000
SCIGBLAST_MAX_ACTIVE_JOBS=2
# Set to 1 when accessed over HTTPS (recommended for production).
# Keep 0 only for trusted internal HTTP testing; credentials are not encrypted by HTTP.
SCIGBLAST_COOKIE_SECURE=0
# First deployment: set a password (6–128 characters) before starting.
# Single-quote the password to preserve literal $ and # characters in Compose.
# An existing administrator is never changed on restart. Clear all three to use the CLI instead.
SCIGBLAST_ADMIN_USERNAME=admin
SCIGBLAST_ADMIN_PASSWORD=
# Optional English display name; defaults to the username.
SCIGBLAST_ADMIN_DISPLAY_NAME=Admin
# Container-side paths (Linux list separator is colon). Must be mounted above.
# New jobs use name_shortid/pipeline_type/YYYYMMDD_HHMMSS/ below this base (Beijing time).
SCIGBLAST_DEFAULT_OUTPUT_ROOT=/colddata/SCigblast/results
SCIGBLAST_ALLOWED_INPUT_ROOTS=/colddata/SCigblast/data
SCIGBLAST_ALLOWED_SUBMISSION_ROOTS=/colddata/SCigblast/data
SCIGBLAST_ALLOWED_BARCODE_ROOTS=/colddata
SCIGBLAST_ALLOWED_OUTPUT_ROOTS=/colddata/SCigblast/results:/colddata/zqy/SCigblast/results
