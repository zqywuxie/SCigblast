# Linux host paths. These values are used by docker-compose.yml.
SCIGBLAST_HOST_PIPELINE_ROOT=/colddata/zqy/SCigblast
SCIGBLAST_HOST_COLD_DATA=/colddata
SCIGBLAST_HOST_RESULTS_ROOT=/colddata/zqy/SCigblast/results
SCIGBLAST_HOST_TOOL_ROOT=/opt/scigblast-tools
SCIGBLAST_WEB_PORT=8000
SCIGBLAST_MAX_ACTIVE_JOBS=2
