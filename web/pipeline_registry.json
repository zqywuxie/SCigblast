{
  "ir_split": {
    "label": "IR split",
    "description": "Bulk IR · 自动识别输入、UMI 代表序列、结果整理",
    "accent": "teal",
    "runner": "IR_split/pipeline/run_ir_pipeline.sh",
    "stages": ["01.match", "02.fastp", "03.split", "04.clean", "05.pandaseq", "06.representative", "07.igblast", "08.preprocessing"],
    "stage_labels": {"01.match": "样本匹配", "02.fastp": "质量过滤", "03.split": "Barcode / UMI 拆分", "04.clean": "Header 清理", "05.pandaseq": "序列合并", "06.representative": "代表序列", "07.igblast": "IgBLAST", "08.preprocessing": "结果整理"},
    "form_fields": ["input_path", "submission_path", "barcode_csv", "output_root", "dataset_label"],
    "completion": "pipeline_done",
    "env_keys": {
      "input": ["SCIGBLAST_RUN_RAW_INPUT_DIR"],
      "submission": ["SCIGBLAST_RUN_SUBMISSION_PATHS"],
      "barcode": ["SCIGBLAST_RUN_BARCODE_CSV"],
      "output": ["SCIGBLAST_OUTPUT_ROOT"],
      "dataset": ["SCIGBLAST_DATASET_LABEL"],
      "input_mode": ["SCIGBLAST_RUN_INPUT_MODE"],
      "variant": ["SCIGBLAST_IR_PIPELINE_VARIANT"],
      "preprocessing": ["SCIGBLAST_RUN_PREPROCESSING"]
    },
    "requires_barcode": true,
    "ir_options": false,
    "match_summary": ["01.match/{dataset}/sample_barcode_summary.csv", "01.match/{dataset}/sample_manifest.csv"]
  },
  "10x_split": {
    "label": "10X split",
    "description": "单细胞 · barcode + UMI 代表序列、链聚类",
    "accent": "amber",
    "runner": "10X_split/pipeline/run_10x_pipeline.sh",
    "stages": ["01.match", "02.fastp", "03.prefilter", "04.clean", "05.pandaseq", "06.split", "07.igblast", "08.cluster"],
    "stage_labels": {"01.match": "样本匹配", "02.fastp": "质量过滤", "03.prefilter": "R1 / R2 预筛选", "04.clean": "Header 清理", "05.pandaseq": "序列合并", "06.split": "Barcode / UMI 代表序列", "07.igblast": "IgBLAST", "08.cluster": "链聚类"},
    "form_fields": ["input_path", "submission_path", "barcode_csv", "output_root", "dataset_label"],
    "completion": "pipeline_done",
    "env_keys": {
      "input": ["SCIGBLAST_RUN_RAW_INPUT_DIR"],
      "submission": ["SCIGBLAST_RUN_SUBMISSION_PATHS"],
      "barcode": ["SCIGBLAST_RUN_BARCODE_CSV"],
      "output": ["SCIGBLAST_OUTPUT_ROOT"],
      "dataset": ["SCIGBLAST_DATASET_LABEL"]
    },
    "requires_barcode": true,
    "ir_options": false,
    "match_summary": ["01.match/{dataset}/sample_barcode_summary.csv", "01.match/{dataset}/sample_manifest.csv"]
  },
  "igblast_base": {
    "label": "IgBLAST base",
    "description": "不拆分的常规 FASTQ：fastp → clean → PANDAseq → IgBLAST。",
    "accent": "indigo",
    "runner": "Igblast_base/pipeline/run_igblast_base.sh",
    "stages": ["01.match", "02.fastp", "03.clean", "04.pandaseq", "05.igblast"],
    "stage_labels": {"01.match": "样本匹配", "02.fastp": "质量过滤", "03.clean": "Header 清理", "04.pandaseq": "序列合并", "05.igblast": "IgBLAST"},
    "form_fields": ["input_path", "submission_path", "output_root", "dataset_label"],
    "completion": "last_stage",
    "env_keys": {
      "input": ["SCIGBLAST_RUN_RAW_INPUT_DIR"],
      "submission": ["SCIGBLAST_RUN_SUBMISSION_PATHS"],
      "output": ["SCIGBLAST_RUN_OUTPUT_ROOT", "SCIGBLAST_OUTPUT_ROOT"],
      "dataset": ["SCIGBLAST_RUN_DATASET_LABEL", "SCIGBLAST_DATASET_LABEL"]
    },
    "requires_barcode": false,
    "ir_options": false,
    "match_summary": ["01.match/{dataset}/sample_manifest.csv", "01.match/{dataset}/sample_barcode_summary.csv"]
  },
  "pig_igblast": {
    "label": "Pig IgBLAST",
    "description": "猪物种 IgBLAST：使用 pig 数据库进行链路匹配。",
    "accent": "coral",
    "runner": "PigIgblast/pipeline/run_pig_pipeline.sh",
    "stages": ["01.match", "02.fastp", "03.clean", "04.pandaseq", "05.igblast"],
    "stage_labels": {"01.match": "样本匹配", "02.fastp": "质量过滤", "03.clean": "Header 清理", "04.pandaseq": "序列合并", "05.igblast": "IgBLAST"},
    "form_fields": ["input_path", "submission_path", "output_root", "dataset_label"],
    "completion": "last_stage",
    "env_keys": {
      "input": ["SCIGBLAST_RUN_RAW_INPUT_DIR"],
      "submission": ["SCIGBLAST_RUN_SUBMISSION_PATHS"],
      "output": ["SCIGBLAST_RUN_OUTPUT_ROOT", "SCIGBLAST_OUTPUT_ROOT"],
      "dataset": ["SCIGBLAST_RUN_DATASET_LABEL", "SCIGBLAST_DATASET_LABEL"]
    },
    "requires_barcode": false,
    "ir_options": false,
    "match_summary": ["01.match/{dataset}/sample_manifest.csv", "01.match/{dataset}/sample_barcode_summary.csv"]
  }
}
