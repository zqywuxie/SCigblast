# IR_split branch configuration. Raw/reference inputs are absolute; outputs
# remain relative to this branch's scripts.
SCIGBLAST_DATA_INPUTS=("/colddata/zqy/XYFY_HZJ1")
# raw: R1 starts with [UMI][primer barcode] and must be demultiplexed.
# presplit: paired FASTQ have an existing terminal #<UMI> (or legacy
# #UMI:<UMI>) header tag.  They are still matched against submission for
# audit/chain validation, then still run through fastp; stage 03 only validates
# and imports the existing UMI-tagged files without a second barcode split.
SCIGBLAST_IR_INPUT_MODE="raw"
# Optional one-run override (does not edit this file):
#   SCIGBLAST_RUN_INPUT_MODE=presplit bash run_ir_pipeline.sh
# Submission sources are an independent collection, not positional pairs
# with DATA_INPUTS.  Every input is matched against all sources and the
# workbook Note field selects the correct raw-data batch.
SCIGBLAST_SUBMISSIONS=("/colddata/zqy/SCigblast/results_260817_HZJ1/reference/Data_submission_For_HZJ剩余.xlsx")
# Each submission entry may be an .xlsx file or a directory containing .xlsx.
SCIGBLAST_BARCODE_CSVS=("/colddata/zqy/SCigblast/reference/8bp_barcodes.csv")
# DATA_INPUTS controls the datasets processed in one invocation.  Submission
# sources are an independent collection: every input is checked against all
# entries and the matcher uses each row's Note path to select the batch.  A
# barcode CSV may be shared with one entry or supplied once per input.
# Raw FASTQ naming is interpreted only by 01.match_sample.py.  Each element
# is R1|R2; one input tree may contain several conventions at the same time.
# _j is R1 and _v is R2.
SCIGBLAST_RAW_READ_SUFFIX_PAIRS=(
  "_R1|_R2"
  "_1|_2"
  "_j|_v"
)
SCIGBLAST_RAW_FASTQ_EXTENSIONS=(
  ".fq.gz"
  ".fastq.gz"
  ".fq"
  ".fastq"
)
# Empty or relative values are resolved by run_ir_pipeline.sh under
# pipeline/../output; absolute values are kept unchanged.
SCIGBLAST_OUTPUT_ROOT=""
SCIGBLAST_FASTP_BIN="fastp"
SCIGBLAST_PANDASEQ_BIN="pandaseq"
SCIGBLAST_IGBLAST_BIN="igblastn"
PYTHON_BIN="python3"

# Set only by the Docker image; standalone runs retain the tools above.
if [[ -n "${SCIGBLAST_RUNTIME_BIN_DIR:-}" ]]; then
    export PYTHON_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/python3"
    export SCIGBLAST_FASTP_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/fastp"
    export SCIGBLAST_PANDASEQ_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/pandaseq"
    export SCIGBLAST_IGBLAST_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/igblastn"
    export FASTP_BIN="$SCIGBLAST_FASTP_BIN" PANDASEQ_BIN="$SCIGBLAST_PANDASEQ_BIN" IGBLAST_BIN="$SCIGBLAST_IGBLAST_BIN"
fi

SCIGBLAST_IGBLAST_DB_DIR="/data/scAnalyis/Scigblast/igblast"
SCIGBLAST_IGBLAST_SPECIES="human"
SCIGBLAST_MEMORY_BUDGET_GB="300"
SCIGBLAST_MIN_FREE_MEMORY_GB="16"
SCIGBLAST_MEMORY_STOP_THRESHOLD_GB="150"
SCIGBLAST_MEMORY_POLL_SECONDS="5"
# Keep valid samples moving when another sample fails; failed stages retain a
# PARTIAL marker and are retried on the next run.
SCIGBLAST_ALLOW_PARTIAL_STAGES="1"
SCIGBLAST_MAX_THREAD_BUDGET="640"
# High-throughput default; stage-specific products stay below ~128 GB RAM.
SCIGBLAST_PARALLEL_THREAD_BUDGET="512"

SCIGBLAST_FASTP_QUAL_THRESHOLD="20"
SCIGBLAST_FASTP_N_BASE_LIMIT="20"
SCIGBLAST_FASTP_THREADS="16"
SCIGBLAST_FASTP_MEMORY_LIMIT_GB="8"
SCIGBLAST_FASTP_MAX_PARALLEL_SAMPLES="16"
SCIGBLAST_CLEAN_THREADS="8"
SCIGBLAST_CLEAN_MEMORY_LIMIT_GB="8"
SCIGBLAST_CLEAN_MAX_PARALLEL_SAMPLES="16"
SCIGBLAST_PANDASEQ_THREADS="16"
SCIGBLAST_PANDASEQ_MEMORY_LIMIT_GB="8"
SCIGBLAST_PANDASEQ_MAX_PARALLEL_SAMPLES="12"
SCIGBLAST_CLEANUP_INTERMEDIATE="0"
SCIGBLAST_FORCE_RERUN="0"
SCIGBLAST_MATCH_ONLY_FIRST_RUN="1"

SCIGBLAST_IR_UMI_LENGTH="10"
SCIGBLAST_IR_WORKERS="32"
# Representative grouping has a much higher per-worker memory footprint than
# FASTQ splitting; keep its concurrency independent from split workers.
SCIGBLAST_IR_REPRESENTATIVE_WORKERS="4"
SCIGBLAST_IR_COMPRESSLEVEL="1"
SCIGBLAST_IR_CHECKPOINT_EVERY="10000"
SCIGBLAST_IR_PROGRESS_FLUSH_EVERY="1000"
SCIGBLAST_IR_MEMORY_GB="16"
SCIGBLAST_IR_REP_MEMORY_GB="96"
SCIGBLAST_IR_REP_PROGRESS_EVERY="100000"
# The representative checkpoint is gzip-compressed and stores one row per
# sample/UMI; primer barcode remains audit metadata only.
SCIGBLAST_IR_DELETE_LEGACY_STATE="0"
# Run Stage 08 preprocessing for representative mode. Set to 0 to disable;
# merged mode skips it automatically when set to auto. The implementation is
# IR_split/pipeline/08.preprocessing.py and its model code is in pipeline/models.
SCIGBLAST_IR_RUN_PREPROCESSING="auto"

# Stage 08 execution controls. These tune scheduling/I/O only; they do not
# alter any model formula, filter threshold, grouping key or umi_counts rule.
SCIGBLAST_IR_PREPROCESSING_FILTER_WORKERS="2"
SCIGBLAST_IR_PREPROCESSING_SAMPLES_PER_WINDOW="1"
SCIGBLAST_IR_PREPROCESSING_SHM_WORKERS="32"
SCIGBLAST_IR_PREPROCESSING_TOTAL_PROCESS_BUDGET="64"
SCIGBLAST_IR_PREPROCESSING_MEMORY_BUDGET_GB="300"
SCIGBLAST_IR_PREPROCESSING_MIN_AVAILABLE_GB="150"
SCIGBLAST_IR_PREPROCESSING_PROGRESS_SECONDS="30"
SCIGBLAST_IR_PREPROCESSING_ALLOW_ROW_CONTRACT="1"
SCIGBLAST_IR_PREPROCESSING_UMI_SOURCE="auto"

SCIGBLAST_IGBLAST_THREADS="16"
SCIGBLAST_IGBLAST_MEMORY_LIMIT_GB="8"
SCIGBLAST_IGBLAST_MAX_PARALLEL_JOBS="16"
SCIGBLAST_IGBLAST_BATCH_FASTA="500"
# Preserve IgBLAST raw batches/job artifacts by default; set to 0 for explicit cleanup.
SCIGBLAST_IGBLAST_KEEP_INTERMEDIATE="1"
