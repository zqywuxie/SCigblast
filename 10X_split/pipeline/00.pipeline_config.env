# 10X_split branch configuration. Raw/reference inputs are absolute; outputs
# remain relative to this branch's scripts.
SCIGBLAST_DATA_INPUTS=("/colddata/zqy/XYFY_HZJ1")
SCIGBLAST_SUBMISSIONS=("/colddata/zqy/SCigblast/results_260817_HZJ1/data/HZJ-移植/Data_submission_For_HZJ剩余.xlsx")
# Each submission entry may be an .xlsx file or a directory containing .xlsx.
SCIGBLAST_BARCODE_CSVS=("/colddata/zqy/SCigblast/results_260817_HZJ1/reference/8bp_barcodes.csv")
# DATA_INPUTS and SUBMISSIONS are independent collections. Every input is
# matched against all submission workbooks by Note; array positions are not
# paired. One or more inputs run in one invocation.
# Raw FASTQ naming rules used only by 01.match_sample.py.  Each suffix pair is
# R1|R2; one input tree may contain more than one naming convention.  _j is
# R1 and _v is R2.  Downstream stages always use canonical _R1/_R2 names.
SCIGBLAST_RAW_READ_SUFFIX_PAIRS=(
  "_R1|_R2"
  "_1|_2"
  "_j|_v"
)
SCIGBLAST_RAW_FASTQ_EXTENSIONS=(
  ".fq.gz"
  ".fastq.gz"
  ".fq"
  ".fastq"
)
# Empty or relative values are resolved by run_10x_pipeline.sh under
# pipeline/../output; absolute values are kept unchanged.
SCIGBLAST_OUTPUT_ROOT=""
SCIGBLAST_FASTP_BIN="fastp"
SCIGBLAST_PANDASEQ_BIN="pandaseq"
SCIGBLAST_IGBLAST_BIN="igblastn"
PYTHON_BIN="python3"

# Set only by the Docker image; standalone runs retain the tools above.
if [[ -n "${SCIGBLAST_RUNTIME_BIN_DIR:-}" ]]; then
    export PYTHON_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/python3"
    export SCIGBLAST_FASTP_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/fastp"
    export SCIGBLAST_PANDASEQ_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/pandaseq"
    export SCIGBLAST_IGBLAST_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/igblastn"
    export FASTP_BIN="$SCIGBLAST_FASTP_BIN" PANDASEQ_BIN="$SCIGBLAST_PANDASEQ_BIN" IGBLAST_BIN="$SCIGBLAST_IGBLAST_BIN"
fi

SCIGBLAST_IGBLAST_DB_DIR="/data/scAnalyis/Scigblast/igblast"
SCIGBLAST_IGBLAST_SPECIES="human"
SCIGBLAST_MEMORY_BUDGET_GB="300"
SCIGBLAST_MIN_FREE_MEMORY_GB="16"
SCIGBLAST_MEMORY_STOP_THRESHOLD_GB="150"
SCIGBLAST_MEMORY_POLL_SECONDS="5"
SCIGBLAST_MAX_THREAD_BUDGET="640"
# High-throughput default; stage-specific products stay below ~144 GB RAM.
SCIGBLAST_PARALLEL_THREAD_BUDGET="512"

SCIGBLAST_FASTP_QUAL_THRESHOLD="20"
SCIGBLAST_FASTP_N_BASE_LIMIT="20"
SCIGBLAST_FASTP_THREADS="16"
SCIGBLAST_FASTP_MEMORY_LIMIT_GB="8"
SCIGBLAST_FASTP_MAX_PARALLEL_SAMPLES="16"
SCIGBLAST_CLEAN_THREADS="8"
SCIGBLAST_CLEAN_MEMORY_LIMIT_GB="8"
SCIGBLAST_CLEAN_MAX_PARALLEL_SAMPLES="16"
SCIGBLAST_PANDASEQ_THREADS="16"
SCIGBLAST_PANDASEQ_MEMORY_LIMIT_GB="16"
SCIGBLAST_PANDASEQ_MAX_PARALLEL_SAMPLES="8"
SCIGBLAST_CLEANUP_INTERMEDIATE="0"
SCIGBLAST_FORCE_RERUN="0"
SCIGBLAST_MATCH_ONLY_FIRST_RUN="1"

SCIGBLAST_10X_TSO_SEQ="TTTCTTATATGGG"
SCIGBLAST_10X_TSO_POS="27"
SCIGBLAST_10X_BARCODE_LEN="16"
SCIGBLAST_10X_WILDCARD_PREFIX="NNN"
SCIGBLAST_10X_REMOVE_R2_PRIMER="1"
SCIGBLAST_10X_SEARCH_RC="0"
# Phase2 uses separate processes; the runner reserves WORKERS * MEMORY below.
SCIGBLAST_10X_WORKERS="3"
SCIGBLAST_10X_PHASE2_BATCH_SIZE="1000"
# Per phase2 process (not the whole stage).
SCIGBLAST_10X_PHASE2_MEMORY_LIMIT_GB="48"
# Prefilter workers are threads in one streaming Python process; this value is
# a stage-level reservation rather than workers multiplied by memory.
SCIGBLAST_10X_PREFILTER_WORKERS="32"
SCIGBLAST_10X_PREFILTER_MEMORY_GB="16"
SCIGBLAST_10X_UMI_LEN="10"
SCIGBLAST_10X_PHASE2_PROGRESS_EVERY="1"
SCIGBLAST_10X_PHASE2_RECORD_PROGRESS_EVERY="100000"
# Progress interval while the compact representative state is being written.
SCIGBLAST_10X_STATE_WRITE_PROGRESS_EVERY="100000"
# Set to 1 only after validating the compact state/public outputs; removes the
# legacy full .representative_state.csv on the next successful phase-2 commit.
SCIGBLAST_10X_DELETE_LEGACY_STATE="0"

SCIGBLAST_IGBLAST_THREADS="16"
SCIGBLAST_IGBLAST_MEMORY_LIMIT_GB="32"
SCIGBLAST_IGBLAST_MAX_PARALLEL_JOBS="4"
SCIGBLAST_IGBLAST_BATCH_FASTA="500"
