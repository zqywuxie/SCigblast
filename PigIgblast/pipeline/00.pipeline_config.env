# Pig IgBLAST pipeline configuration.
#
# This is the single configuration file for every stage and for
# run_pig_pipeline.sh.  Keep input/reference paths absolute; stage outputs are
# resolved relative to the pipeline directory by the individual scripts.
SCIGBLAST_DATA_INPUTS=("/colddata/zqy/PigIgblast/data/data_260622")
SCIGBLAST_SUBMISSIONS=("/colddata/zqy/PigIgblast/submission/Data_submission_For_20260622_ARP01_pig.xlsx")
# Each submission entry may be an .xlsx file or a directory containing .xlsx.
SCIGBLAST_BARCODE_CSVS=()
SUBMISSION_SHEET=""
# Raw suffix recognition is confined to 01.match_sample.py.  _j is R1 and
# _v is R2; fastp and every later stage use canonical _R1/_R2.fq.gz.
SCIGBLAST_RAW_READ_SUFFIX_PAIRS=(
  "_R1|_R2"
  "_1|_2"
  "_j|_v"
)
SCIGBLAST_RAW_FASTQ_EXTENSIONS=(
  ".fq.gz"
  ".fastq.gz"
  ".fq"
  ".fastq"
)
# Empty or relative values are resolved by run_pig_pipeline.sh under
# pipeline/../output; absolute values are kept unchanged.
SCIGBLAST_OUTPUT_ROOT=""
SCIGBLAST_FASTP_BIN="fastp"
SCIGBLAST_PANDASEQ_BIN="pandaseq"
SCIGBLAST_IGBLAST_BIN="/colddata/zqy/igblast/bin/igblastn"
PYTHON_BIN="python3"

# Outputs use each input directory basename; duplicate basenames receive a
# stable suffix. Submission workbooks are a shared independent collection and
# are selected by Note rather than array position.
FASTP_BIN="fastp"
PANDASEQ_BIN="pandaseq"
IGBLAST_BIN="/colddata/zqy/igblast/bin/igblastn"

# Set only by the Docker image; standalone runs retain the tools above.
if [[ -n "${SCIGBLAST_RUNTIME_BIN_DIR:-}" ]]; then
    export PYTHON_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/python3"
    export SCIGBLAST_FASTP_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/fastp"
    export SCIGBLAST_PANDASEQ_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/pandaseq"
    export SCIGBLAST_IGBLAST_BIN="${SCIGBLAST_RUNTIME_BIN_DIR}/igblastn"
    export FASTP_BIN="$SCIGBLAST_FASTP_BIN" PANDASEQ_BIN="$SCIGBLAST_PANDASEQ_BIN" IGBLAST_BIN="$SCIGBLAST_IGBLAST_BIN"
fi

DB_ROOT="/colddata/zqy/igblast"
PIG_DB_VERSION="pig_chain"

SCIGBLAST_MAX_THREAD_BUDGET="640"
# High-throughput default; keep 150 GB MemAvailable as the stop boundary.
SCIGBLAST_PARALLEL_THREAD_BUDGET="512"
SCIGBLAST_FASTP_THREADS="16"
SCIGBLAST_FASTP_MAX_PARALLEL_SAMPLES="16"
SCIGBLAST_FASTP_MEMORY_LIMIT_GB="8"
SCIGBLAST_CLEAN_THREADS="8"
SCIGBLAST_CLEAN_MAX_PARALLEL_SAMPLES="16"
SCIGBLAST_CLEAN_MEMORY_LIMIT_GB="8"
SCIGBLAST_PANDASEQ_THREADS="16"
SCIGBLAST_PANDASEQ_MAX_PARALLEL_SAMPLES="8"
SCIGBLAST_PANDASEQ_MEMORY_LIMIT_GB="16"
SCIGBLAST_IGBLAST_THREADS="16"
SCIGBLAST_IGBLAST_MAX_PARALLEL_JOBS="4"
SCIGBLAST_IGBLAST_MEMORY_LIMIT_GB="32"
SCIGBLAST_MEMORY_BUDGET_GB="300"
SCIGBLAST_MIN_FREE_MEMORY_GB="16"
SCIGBLAST_MEMORY_STOP_THRESHOLD_GB="150"
SCIGBLAST_MEMORY_POLL_SECONDS="5"

SCIGBLAST_FASTP_QUAL_THRESHOLD="20"
SCIGBLAST_FASTP_N_BASE_LIMIT="20"
SCIGBLAST_CLEANUP_INTERMEDIATE="0"
SCIGBLAST_ALLOW_MAPPING_ERRORS="1"
# First invocation only creates the mapping manifest for manual review.
SCIGBLAST_MATCH_ONLY_FIRST_RUN="1"
